<?php

namespace App\Policies;

use App\Models\User;

/** Superadmin is handled by Gate::before. Permissions are declared in config/permissions.php. */
class {{Model}}Policy
{
    public function viewAny(User $user): bool
    {
        return $user->checkPermissionTo('{{plural}}.view');
    }

    public function view(User $user): bool
    {
        return $user->checkPermissionTo('{{plural}}.view');
    }

    public function create(User $user): bool
    {
        return $user->checkPermissionTo('{{plural}}.create');
    }

    public function update(User $user): bool
    {
        return $user->checkPermissionTo('{{plural}}.update');
    }

    public function delete(User $user): bool
    {
        return $user->checkPermissionTo('{{plural}}.delete');
    }
}
