# Copy to .env and change every "change-me".
COMPOSE_PROJECT_NAME=gd-webapp-starter
COMPOSE_PROFILES=dev
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_DOMAIN=gd-webapp-starter.localhost

# Pins (source of truth: docs/VERSIONS.md; checked by `sh scripts/check.sh`)
PHP_VERSION=8.5.12
LARAVEL_VERSION=13.29.0
COMPOSER_VERSION=2.11.2
NODE_VERSION=24.22.3
NGINX_VERSION=1.30.6
POSTGRES_VERSION=18.6
MAILPIT_VERSION=v1.33.1
VITE_VERSION=8.3.8
REACT_VERSION=19.3.1

# Ports (31xxx block). Published: nginx, postgres, mailpit. Dev ports are internal to the node container.
NGINX_HTTP_PORT=31080
POSTGRES_PORT=31432
MAILPIT_SMTP_PORT=31025
MAILPIT_UI_PORT=31026
ADMIN_DEV_PORT=31301

POSTGRES_DB=gd_webapp_starter
POSTGRES_USER=gd_webapp_starter
POSTGRES_PASSWORD=change-me

LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=en

# Uploads (mount point inside php + nginx containers; max size in MB)
UPLOADS_CONTAINER_PATH=/var/www/uploads
UPLOADS_MAX_MB=5

# Admin SPA OAuth client id (must equal OAUTH_ADMIN_CLIENT_ID in api/.env)
OAUTH_ADMIN_CLIENT_ID=e98a6a07-2975-4f52-941e-d9b6b27eb580
